# COMMANDS to be included by CCS builder (gmake) to provide OS-agnostic commands 
ifeq ($(CCS_HOST_OS),win32)
    RENAME  := ren
    DELETE  := del
    COPY    := copy
    
    # Copy Kit.json generated by syscfg back into workspace root so CompDesigner would get the updated input
    # Only Copies when artifact exists (i.e CompDesigner is enabled)
    ifeq ($(wildcard ${CWD}\syscfg\Kit.json),)
    	POWERSUITE_POSTSTEP =+
    else
    	POWERSUITE_POSTSTEP =+ $(COPY) ${CWD}\syscfg\Kit.json ${CWD}\..\Kit.json;
    endif
else ifeq ($(CCS_HOST_OS),linux)
	RENAME  := mv
    DELETE  := rm
    COPY    := cp
    
    ifeq ($(wildcard ${CWD}/syscfg/Kit.json),)
    	POWERSUITE_POSTSTEP =+
    else
    	POWERSUITE_POSTSTEP =+ $(COPY) ${CWD}/syscfg/Kit.json ${CWD}/../Kit.json;
    endif
else
	RENAME  := mv
    DELETE  := rm
    COPY    := cp
    
	ifeq ($(wildcard ${CWD}/syscfg/Kit.json),)
    	POWERSUITE_POSTSTEP =+
    else
    	POWERSUITE_POSTSTEP =+ $(COPY) ${CWD}/syscfg/Kit.json ${CWD}/../Kit.json;
    endif
endif